def minWindow(self, s, t):
        if not s or not t:
            return ""

        need = {}
        for ch in t:
            need[ch] = need.get(ch, 0) + 1

        left = 0
        count = 0
        min_len = float("inf")
        answer = ""

        for right in range(len(s)):
            ch = s[right]

            if ch in need:
                need[ch] -= 1
                if need[ch] >= 0:
                    count += 1

            while count == len(t):
                if right - left + 1 < min_len:
                    min_len = right - left + 1
                    answer = s[left:right + 1]

                left_ch = s[left]

                if left_ch in need:
                    need[left_ch] += 1
                    if need[left_ch] > 0:
                        count -= 1

                left += 1

        return answer
        
